# ---- Acesso (obrigatório em produção) ----
# Senha única para entrar na plataforma (uso pessoal).
APP_PASSWORD=troque-esta-senha
# Segredo para assinar o cookie de sessão. Gere com: openssl rand -hex 32
SESSION_SECRET=

# ---- Origens ----
# Endereço da plataforma e o endereço SEPARADO onde os artefatos rodam.
# Em produção, aponte um segundo domínio/subdomínio para o mesmo deploy
# (ex.: app.seudominio.com e run.seudominio.com). Em desenvolvimento, deixe
# vazio: localhost e 127.0.0.1 já são origens diferentes.
APP_ORIGIN=
NEXT_PUBLIC_RUNNER_ORIGIN=

# ---- Banco (opcional) ----
# Sem estas variáveis, os dados ficam em arquivos na pasta ./data (bom para
# rodar no seu computador). Para hospedar (Vercel etc.), use o Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
