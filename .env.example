# ---- Login (obrigatório online) ----
# Entrar com Google: só os e-mails de ALLOWED_EMAILS entram (separe vários por vírgula).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=
# Texto aleatório longo (40+ caracteres) que protege o cookie de sessão. Nunca compartilhe.
SESSION_SECRET=
# Opcional: senha única (útil no computador ou como reserva). Deixe vazio online se usar Google.
APP_PASSWORD=
# O acesso vale até a meia-noite deste fuso; depois é preciso entrar de novo.
SESSION_TIMEZONE=America/Sao_Paulo

# ---- Origens ----
# Endereço da plataforma e o endereço SEPARADO onde os artefatos rodam (os dois no mesmo deploy).
# Ex. na Vercel: APP_ORIGIN=https://aline-artefatos.vercel.app
#                NEXT_PUBLIC_RUNNER_ORIGIN=https://aline-artefatos-run.vercel.app
# Em desenvolvimento, deixe vazio: localhost e 127.0.0.1 já são origens diferentes.
APP_ORIGIN=
NEXT_PUBLIC_RUNNER_ORIGIN=

# ---- Banco (obrigatório online) ----
# Sem estas variáveis, os dados ficam em arquivos na pasta ./data (só serve no seu computador).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
